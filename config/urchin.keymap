#include "pointing_config.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "keymap_italian.h"

// Layer definitions

#define BASE 0
#define SYM 1
#define EXT 2
#define FNC 3
#define SYM2 4
#define ACCENT 5
#define SETTINGS 6
#define APP 9
#define RAYCAST 10
#define JUMP 11

// -----------------

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&sk {
    // don't release mods on other mods presses

    ignore-modifiers;
};

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"

        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "QUICK_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        // sometimes my device thinks a modifier is being held down
        // pressing all modifiers fixes it.

        unstick: unstick {
            label = "ZM_unstick";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // The two left thumb keys act as Totem's middle left thumb key.
        left_thumb_middle {
            timeout-ms = <200>;
            key-positions = <30 31>;
            layers = <BASE>;
            bindings = <&lt 2 SPACE>;
        };

        // The two right thumb keys act as Totem's middle right thumb key.
        right_thumb_middle {
            timeout-ms = <200>;
            key-positions = <32 33>;
            layers = <BASE>;
            bindings = <&lt 5 BACKSPACE>;
        };

        // both left thumb keys
        // left index & middle fingers (home-row)
        // hold control & space for Adobe workflow

        combo_launcher {
            timeout-ms = <30>;
            key-positions = <0 1>;
            layers = <BASE>;
            bindings = <&kp LG(LS(SPACE))>;
        };

        combo_jump {
            timeout-ms = <30>;
            key-positions = <8 9>;
            layers = <BASE>;
            bindings = <&sl JUMP>;
        };

        combo_app {
            timeout-ms = <30>;
            key-positions = <23 24>;
            layers = <BASE>;
            bindings = <&sl APP>;
        };

        combo_raycast {
            timeout-ms = <30>;
            key-positions = <25 26>;
            layers = <BASE>;
            bindings = <&sl RAYCAST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Base alpha layer

        default_layer {
            label = "Base";
            bindings = <
&kp Q           &kp W           &kp E               &kp R             &kp T      &kp Y        &kp U              &kp I                &kp O            &kp P
&mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_CONTROL D  &mt LEFT_SHIFT F  &kp G      &kp H        &mt RIGHT_SHIFT J  &mt RIGHT_CONTROL K  &mt RIGHT_ALT L  &mt RIGHT_GUI SQT
&lt 7 Z         &kp X           &kp C               &kp V             &kp B      &kp N        &kp M              &kp COMMA            &kp DOT          &kp SLASH
                                                    &lt 1 ESC         &lt 3 TAB  &lt 4 ENTER  &lt 6 DELETE
            >;
        };

        // Numbers and high frequency symbols

        media_layer {
            label = "Med";
            bindings = <
&none         &none         &none             &none           &none  &bt BT_CLR  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &none       &kp C_PREV     &kp C_VOL_DN   &kp C_VOL_UP   &kp C_NEXT
&none         &none         &none             &none           &none  &none       &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3
                                              &none           &none  &kp C_STOP  &kp C_PP
            >;
        };

        // Main modifiers and arrow keys

        nav_layer {
            label = "Nav";
            bindings = <
&none         &kp F13       &kp F14           &kp F15         &none  &kp LS(LG(Z))  &kp LG(V)      &kp LG(C)  &kp LG(X)     &kp LG(Z)
&kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LEFT_SHIFT  &none  &kp CAPSLOCK   &kp LEFT       &kp DOWN   &kp UP_ARROW  &kp RIGHT_ARROW
&none         &none         &none             &none           &none  &kp INS        &kp HOME       &kp PG_DN  &kp PG_UP     &kp END
                                              &none           &none  &kp ENTER      &kp BACKSPACE
            >;
        };

        // Function keys with modifiers

        mouse_layer {
            label = "Mou";
            bindings = <
&none     &none         &none           &mo 7           &kp F16    &kp LG(LS(Z))  &kp LG(V)           &kp LG(C)           &kp LG(X)        &kp LG(Z)
&kp LGUI  &kp LEFT_ALT  &kp LCTRL       &kp LEFT_SHIFT  &mkp LCLK  &mkp LCLK      &mmv MOVE_LEFT      &mmv MOVE_DOWN      &mmv MOVE_UP     &mmv MOVE_RIGHT
&none     &none         &msc SCRL_DOWN  &msc SCRL_UP    &mkp RCLK  &mkp RCLK      &msc (MOVE_X(-15))  &msc (MOVE_Y(-15))  &msc MOVE_Y(15)  &msc MOVE_X(15)
                                        &none           &none      &mkp RCLK      &mkp LCLK
            >;
        };

        // Low frequency symbols.

        sym_layer {
            label = "Sym";
            bindings = <
&kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE  &none  &none  &none  &none  &none
&kp COLON       &kp DOLLAR       &kp PERCENT   &kp CARET              &kp PLUS         &none  &none  &none  &none  &none
&kp TILDE       &kp EXCLAMATION  &kp AT_SIGN   &kp HASH               &kp PIPE         &none  &none  &none  &none  &none
                                               &kp RIGHT_PARENTHESIS  &kp UNDERSCORE   &none  &none
            >;
        };

        // Used to type regional accents.

        number_layer {
            label = "Num";
            bindings = <
&kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET  &none  &none            &none              &none          &none
&kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL          &none  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
&kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH      &none  &none            &none              &none          &none
                                              &kp N0        &kp MINUS          &none  &none
            >;
        };

        // Used to change the keyboard's settings.

        func_layer {
            label = "Fun";
            bindings = <
&kp F12  &kp F7  &kp F8  &kp F9     &kp PSCRN        &trans  &trans           &trans             &trans         &trans
&kp F11  &kp F4  &kp F5  &kp F6     &kp SLCK         &trans  &kp RIGHT_SHIFT  &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI
&kp F10  &kp F1  &kp F2  &kp F3     &kp PAUSE_BREAK  &trans  &trans           &trans             &trans         &trans
                         &kp SPACE  &kp TAB          &trans  &trans
            >;
        };

        left_mouse {
            bindings = <
&trans    &trans        &trans            &trans          &trans     &kp LS(LG(Z))   &kp LG(V)             &kp LG(C)           &kp LG(X)             &kp LC(Z)
&kp LGUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &msc SCRL_DOWN  &mkp LCLK  &msc SCRL_DOWN  &mmv (MOVE_X(-4000))  &mmv MOVE_Y(4000)   &mmv (MOVE_Y(-4000))  &mmv MOVE_X(4000)
&trans    &trans        &trans            &msc SCRL_UP    &mkp RCLK  &msc SCRL_UP    &msc (MOVE_X(-25))    &msc (MOVE_Y(-25))  &msc MOVE_Y(25)       &msc MOVE_X(25)
                                          &trans          &trans     &mkp RCLK       &mkp LCLK
            >;
        };

        boot {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                             &trans  &trans  &trans  &trans
            >;
        };

        app_layer {
            label = "APP";
            bindings = <
&kp RS(RA(RC(RG(Q))))  &kp RS(RA(RC(RG(W))))  &kp RS(RA(RC(RG(E))))  &kp RS(RA(RC(RG(R))))  &kp RS(RA(RC(RG(T))))  &kp RS(RA(RC(RG(Y))))  &kp RS(RA(RC(RG(U))))  &kp RS(RA(RC(RG(I))))      &kp RS(RA(RC(RG(O))))       &kp RS(RA(RC(RG(P))))
&kp RS(RA(RC(RG(A))))  &kp RS(RA(RC(RG(S))))  &kp RS(RA(RC(RG(D))))  &kp RS(RA(RC(RG(F))))  &kp RS(RA(RC(RG(G))))  &kp RS(RA(RC(RG(H))))  &kp RS(RA(RC(RG(J))))  &kp RS(RA(RC(RG(K))))      &kp RS(RA(RC(RG(L))))       &kp RS(RA(RC(RG(SQT))))
&kp RS(RA(RC(RG(Z))))  &kp RS(RA(RC(RG(X))))  &kp RS(RA(RC(RG(C))))  &kp RS(RA(RC(RG(V))))  &kp RS(RA(RC(RG(B))))  &kp RS(RA(RC(RG(N))))  &kp RS(RA(RC(RG(M))))  &kp RA(RS(RC(RG(COMMA))))  &kp RS(RA(RC(RG(PERIOD))))  &kp RS(RA(RC(RG(SLASH))))
                                                                     &trans                 &trans                 &trans                 &trans
            >;
        };

        raycast_layer {
            label = "RAYCAST";
            bindings = <
&trans  &kp RS(RA(RC(RG(NUMBER_2))))  &kp RS(RA(RC(RG(NUMBER_3))))   &kp RS(RA(RC(RG(NUMBER_4))))  &trans  &trans  &trans                  &kp RS(RA(RC(RG(NUMBER_6))))  &kp RS(RA(RG(RC(N7))))  &trans
&trans  &kp RA(RS(RC(RG(F20))))       &kp RS(RA(RC(RG(SEMICOLON))))  &kp RS(RA(RC(RG(NUMBER_1))))  &trans  &trans  &kp RS(RA(RC(RG(N8))))  &kp RS(RA(RC(RG(N9))))        &kp RS(RA(RC(RG(N0))))  &trans
&trans  &kp RS(RA(RC(RG(F17))))       &kp RS(RA(RC(RG(F18))))        &kp RS(RA(RC(RG(F19))))       &trans  &trans  &kp RS(RA(RC(RG(N5))))  &trans                        &trans                  &trans
                                                                     &trans                        &trans  &trans  &trans
            >;
        };

        jump_layer {
            label = "JUMP";
            bindings = <
&trans  &kp RS(RA(RC(RG(F7))))  &kp RS(RA(RC(RG(F8))))  &kp RS(RA(RC(RG(F9))))  &trans  &trans  &kp RS(RA(RC(RG(F7))))  &kp RS(RA(RC(RG(LS(F8)))))  &kp RS(RA(RC(RG(F9))))  &trans
&trans  &kp RS(RA(RC(RG(F4))))  &kp RS(RA(RC(RG(F5))))  &kp RS(RA(RC(RG(F6))))  &trans  &trans  &kp RS(RA(RC(RG(F4))))  &kp RS(RA(RC(RG(F5))))      &kp RS(RA(RC(RG(F6))))  &trans
&trans  &kp RS(RA(RC(RG(F1))))  &kp RS(RA(RC(RG(F2))))  &kp RS(RA(RC(RG(F3))))  &trans  &trans  &kp RS(RA(RC(RG(F1))))  &kp RS(RA(RC(RG(F2))))      &kp RS(RA(RC(RG(F3))))  &trans
                                                        &trans                  &trans  &trans  &trans
            >;
        };
    };
};
